# Dashboard server
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3400
DASHBOARD_TIMEZONE=-5  # UTC offset in hours (e.g., -5 for EST, +1 for CET, 0 for UTC)
DASHBOARD_COLLECT_INTERVAL_MIN=20  # In-process auto-collector cadence in minutes; 0 disables it

# Per-session fuel from local transcripts ("What burned it" panel)
DASHBOARD_SESSION_SCAN_INTERVAL_MIN=30   # Transcript scan cadence in minutes; 0 disables the panel
DASHBOARD_SESSION_MIN_FUEL=10000         # Sessions under this many fuel tokens are treated as noise
DASHBOARD_TRANSCRIPTS_ROOT=              # Defaults to ~/.claude/projects

# Remote sync (used by scripts/push-usage.sh on remote machines, optional)
DASHBOARD_URL=http://localhost:3400
