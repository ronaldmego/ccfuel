# Copy to .env and load it explicitly — nothing reads .env on its own:
#   node --env-file=.env server.js
# Plain `node server.js` uses the defaults below.

# --- Dashboard server ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3400

# UTC offset in hours (-5 for EST, +1 for CET, 0 for UTC). No DST handling.
# Used by the server, the frontend, and the /usage reset parser alike.
DASHBOARD_TIMEZONE=-5

# Where snapshots are written. Defaults to ./data, created on boot if missing.
DASHBOARD_DATA_DIR=

# --- Usage collector (the live gauge) ---
# In-process auto-collector cadence in minutes; 0 disables it.
DASHBOARD_COLLECT_INTERVAL_MIN=20

# Where the gauge is read from. `auto` tries, in order: the usage endpoint (the same call
# Claude Code makes, using the OAuth token already on this machine), then Claude Code's
# cached copy of that reply in ~/.claude.json, then driving /usage in a PTY.
# Pin one with `endpoint`, `cache` or `pty` to test or to keep ccfuel away from the token.
DASHBOARD_USAGE_SOURCE=auto

# How old Claude Code's cached usage may be, in minutes, before the `cache` source refuses
# to serve it as if it were live. Only that source reads it.
DASHBOARD_USAGE_CACHE_MAX_AGE_MIN=30

# PTY fallback only. Folder to spawn `claude` in: Claude Code trusts folders one by one and
# asks before working in an unknown one, and that prompt swallows the /usage keystrokes — so
# if the ccfuel checkout is not a folder you have trusted, point this at one that is.
# Empty = inherit the server's working directory.
DASHBOARD_CLAUDE_CWD=

# --- Per-session fuel from local transcripts ("What burned it" panel) ---
# Transcript scan cadence in minutes; 0 disables the panel.
DASHBOARD_SESSION_SCAN_INTERVAL_MIN=30
# Sessions under this many fuel tokens are treated as noise.
DASHBOARD_SESSION_MIN_FUEL=10000
# Defaults to ~/.claude/projects
DASHBOARD_TRANSCRIPTS_ROOT=

# --- Capture mode ---
# 1 = serve whatever is already in DASHBOARD_DATA_DIR and collect nothing (no PTY spawn, no
# transcript read), with a "synthetic data" banner in the UI. Use `npm run demo`, which builds
# a fixture and sets this for you. Never set it on a real instance.
DASHBOARD_DEMO=
